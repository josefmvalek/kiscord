{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./js/*"],
      "@core/*": ["./js/core/*"],
      "@domains/*": ["./js/domains/*"],
      "@shared/*": ["./js/shared/*"],
      "@types/*": ["./js/types/*"]
    }
  },
  "include": [
    "js/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "archived",
    "supabase/.temp",
    "tmp"
  ]
}
