{
  "name": "project-k",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "",
  "main": "js/main.js",
  "scripts": {
    "start": "serve .",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "npm run lint && npm run typecheck && npm run test:run && npm run test:e2e",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -p jsconfig.json",
    "types:db": "supabase gen types typescript --local > js/types/database.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://josefmvalek@github.com/josefmvalek/project-k.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/josefmvalek/project-k/issues"
  },
  "homepage": "https://github.com/josefmvalek/project-k#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.42.1",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^13.8.3",
    "postcss": "^8.5.9",
    "serve": "^14.2.6",
    "supabase": "^2.95.3",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.2",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cwebp": "^3.2.0"
  }
}
